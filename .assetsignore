# Files under the assets directory (the repo root) that must NOT be uploaded
# as public static assets. Same syntax as .gitignore; Wrangler skips anything
# matching, so these are never published rather than merely unreachable.
#
# This replaces the old Pages approach of deleting files during the build.
# Nothing here is destructive, and it is version-controlled alongside the code
# it protects.
#
# leaderboard/dev-server.ts parses this file directly rather than restating it,
# so the local server blocks exactly what the deploy does. Keep the syntax to
# what is used below — `dir/`, plain names, and `*` — or teach it the rest.

# server code — runs in the Worker, is not part of the site
worker/
leaderboard/

# deployment + tooling config
wrangler.toml
package.json
package-lock.json
node_modules/
.wrangler/
.assetsignore
.nvmrc
.github/

# TypeScript sources — the browser is served the built .js, not these
*.ts
tsconfig*.json
build.mjs

# docs and tests. The suites are *.test.ts, already covered by *.ts above.
*.md
*.sql

# local secrets, should never exist in a deploy but belt and braces
.dev.vars
.dev.vars.example

# meta
.git/
.gitignore
.DS_Store
